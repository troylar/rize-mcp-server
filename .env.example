# Rize API Configuration
# Get your API key from: https://dashboard.rize.io/settings/api-keys
RIZE_API_KEY=your_rize_api_key_here
RIZE_API_URL=https://api.rize.io/api/v1/graphql

# MCP Server Configuration
MCP_SERVER_NAME=rize-mcp-server
MCP_SERVER_VERSION=0.1.0

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Schema Cache
SCHEMA_CACHE_ENABLED=true
SCHEMA_CACHE_TTL=3600  # seconds (1 hour)
